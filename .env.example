# KmerFoodLens — Variables d'environnement Expo
# Copier ce fichier en .env et remplir les valeurs réelles.
# Les variables EXPO_PUBLIC_* sont bundlées dans l'app (visibles côté client).

# ── Clé de chiffrement AES-256-GCM (doit correspondre à ENCRYPTION_KEY du backend)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPO_PUBLIC_ENCRYPTION_KEY=

# ── URL de l'API (optionnel — si différent du défaut dans config.ts)
# EXPO_PUBLIC_API_URL=http://192.168.1.x:3000   ← IP locale pour tests physiques

# ── Google Sign-In — 3 client IDs créés dans Google Cloud Console (mêmes projet KmerFoodLens),
# doivent correspondre à GOOGLE_WEB_CLIENT_ID / GOOGLE_ANDROID_CLIENT_ID / GOOGLE_IOS_CLIENT_ID
# côté backend, utilisés pour vérifier le ID token.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
